# CodeOffer 本地配置模板:复制为 config/.env 并填入真实值(不入库)
# LLM key 静态加密主密钥(必填,32 字节 Base64);丢失则所有用户已存 Key 不可解密,务必备份
# 生成: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
LLM_MASTER_KEY=请填写

# LLM 回退配置(可选):供设置页「从 .env 导入」与 AI 服务直调回退;
# 多用户生成一律使用各用户激活的档案(BYOK),不回退到这里
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
# 代理/自签名证书环境若报 SSL 错误,可设 LLM_VERIFY_SSL=false(默认 true)
# LLM_VERIFY_SSL=false
# 网关不读系统代理环境变量(NO_PROXY 畸形条目会击穿 httpx);需要代理时显式指定:
# LLM_PROXY=http://127.0.0.1:7897
# LLM 调用最小间隔(秒):低 RPM/TPM 配额提供商用间隔避开限流窗口;0=关闭(默认)
# LLM_MIN_INTERVAL_SECONDS=65

# 端口
BACKEND_PORT=8080
AI_SERVICE_PORT=8001

# MySQL 连接（本机服务名 MySQL；密码不入库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=codeoffer
MYSQL_USER=codeoffer_app
MYSQL_PASSWORD=请填写
# 仅 Docker Compose 的 mysql 容器初始化使用
MYSQL_ROOT_PASSWORD=请填写
